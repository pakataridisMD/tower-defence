    "water_intro": {
      "Frostmere was a frozen sea, and the Tidefolk kept every memory of the world in its ice.": "awe",
      "Then the Flame came running across it, and the memories began to melt.": "dread"
    },
    "water_warden": {
      "The Tidal Leviathan sank into the black water, and the bells in it rang true again.": "triumph",
      "That night, Mirelle looked into the ice for a long time.": "tender",
