[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"storm_1"
display_name = "Windswept Pass"
description = "A narrow pass between standing stones. Thunder is waiting to be called."
map = &"c_storm_1"
allowed_elements = Array[StringName]([&"storm", &"nature", &"fire"])
starting_nodes = Array[StringName]([&"storm_entry"])
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("Home ground: Storm towers deal 20% more damage.", "Only Storm, Nature and Fire can be drafted. You start with Storm.", "Every element can be drafted. Every wave mixes elements, and enemies come from several roads.")
first_clear_points = 3

