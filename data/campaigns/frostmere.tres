[resource]
script = ExtResource("1_s")
id = &"frostmere"
display_name = "Frostmere"
order = 3
element = &"water"
tagline = "The Flame against the Ice"
description = "The lake is boiling at the edges. Fire's horde marches across the ice, and its runners are fast. Slow them, freeze them, drown them."
