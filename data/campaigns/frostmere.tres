[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"water_1"
display_name = "Tidepool Shore"
description = "Fishing huts and frozen nets. The first drowned crawl up the shingle."
map = &"c_water_1"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"starting_gold"
kind = 0
value = 60.0

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"water_2"
display_name = "Saltmarsh Bends"
description = "Reed beds and narrow causeways. Runners come in long, quick lines."
map = &"c_water_2"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Saltmother Ourra, the Drowned Herald (shields the horde).", "Fishing fleet: start with 60 more gold.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"gold_per_wave"
kind = 1
value = -0.3

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"water_3"
display_name = "Frozen Causeway"
description = "The causeway crosses the lake four times. The ice groans under the Warded."
map = &"c_water_3"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Frozen trade: 30% less gold after each wave.")
first_clear_points = 3

[sub_resource type="Resource" id="r9"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"water_4"
display_name = "The Drowned Throne"
description = "The Tidal Leviathan rises from the black water: too big to slow, too old to freeze. Fire must boil it."
map = &"c_water_4"
is_guardian = true
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Water, and fears Fire.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"attack_range"
kind = 1
value = 0.08
required_tags = Array[StringName]([&"water"])

[resource]
script = ExtResource("1_s")
id = &"frostmere"
display_name = "Frostmere"
order = 3
element = &"water"
tagline = "The Tide turned on its own lake"
description = "The lake has risen against its shores, and the drowned walk across the ice. Water barely wets them. Fire boils the Tide away."
requires_campaigns = Array[StringName]([&"verdant_deep"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of the Tide"
reward_description = "Water towers have 8% increased range in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
