[resource]
script = ExtResource("1_s")
id = &"hollow_rift"
display_name = "The Hollow Rift"
order = 5
element = &"void"
tagline = "The Hollow turned on its own rift"
description = "The rift where the ring cracked first. The Hollow's own dead and shades pour out of it, and the Void does nothing to them. Nature fills the hollow."
requires_campaigns = Array[StringName]([&"sunscar_canyon"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of the Hollow"
reward_description = "Void towers deal 10% increased damage in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
