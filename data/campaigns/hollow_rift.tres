[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"void_1"
display_name = "Starless Path"
description = "No stars over this road. The grass glows faintly purple."
map = &"c_void_1"
horde_element = &"void"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Void: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

