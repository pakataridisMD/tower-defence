kind = 1
value = -0.05

[resource]
script = ExtResource("1_s")
id = &"assault"
display_name = "The Crownless Citadel"
order = 7
element = &""
tagline = "Through the Crack, into Nhal Vorath"
description = "Solenne held. Now we stop running. Through the Crack lies Nhal Vorath, the Crownless Citadel: break its living gate, climb the Mirror Spire, and unmake the Sunderer on his throne."
requires_campaigns = Array[StringName]([&"convergence"])
stages = Array[ExtResource("4_s")]([SubResource("r4")])
reward_name = "Lantern of the White Order"
reward_description = "Every tower deals 5% more damage and costs 5% less in every run."
reward_modifiers = Array[ExtResource("3_s")]([SubResource("r5"), SubResource("r6")])
