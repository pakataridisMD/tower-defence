[sub_resource type="Resource" id="r4"]
script = ExtResource("4_s")
id = &"assault_1"
display_name = "Nhal Vorath"
description = "The citadel's roads run west toward our camp. Hold them, push your towers east, and bring Nhal Vorath down piece by piece. It will not end until the Sunderer is finished."
map = &"c_assault_1"
is_guardian = true
modifiers = Array[ExtResource("3_s")]([])
rule_text = PackedStringArray("Every element can be drafted. The horde comes down three roads from the fortress.", "The Black Gate: bring down the Gatemaw. It closes the two flank roads, and the six Heralds return as Echoes.", "The Mirror Spire: topple it. It silences towers near it.", "The Crownless Throne: break it, then unmake Vael-Orrun before he reaches your camp.", "You can only build on ground you hold: it moves east as each phase falls.", "Waves start on their own 12 seconds after the last one (Space calls the next one early). When the waves run out, the last one comes again, stronger.")
starting_lives = 30
first_clear_points = 20
structures = Array[ExtResource("2_s")]([SubResource("r1"), SubResource("r2"), SubResource("r3")])
build_columns = PackedInt32Array(22, 29, -1)
auto_wave_delay = 12.0

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
stat = &"damage"
kind = 2
value = 0.05

[sub_resource type="Resource" id="r6"]
script = ExtResource("3_s")
