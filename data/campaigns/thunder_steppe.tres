[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"storm_1"
display_name = "Windswept Pass"
description = "A narrow pass between standing stones. Thunder is waiting to be called."
map = &"c_storm_1"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"attacks_per_second"
kind = 1
value = 0.1

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"storm_2"
display_name = "Galeback Ridge"
description = "Splitters crack open on the ridge. Chain lightning loves a crowd."
map = &"c_storm_2"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Vholt Stormcrown, the Sky Herald (blinks, silences towers).", "Tailwind: towers attack 10% faster.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"cost"
kind = 1
value = 0.15

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"storm_3"
display_name = "The Long Squall"
description = "The road dives down and climbs back up three times. Long, but never far from a spire."
map = &"c_storm_3"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Thin air: towers cost 15% more.")
first_clear_points = 3

[sub_resource type="Resource" id="r9"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"storm_4"
display_name = "Eye of the Storm"
description = "The Thunderhead spins at the centre of the last storm. Nothing slows it, and lightning only tickles. Bring Earth."
map = &"c_storm_4"
is_guardian = true
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Storm, and fears Earth.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"attacks_per_second"
kind = 1
value = 0.08
required_tags = Array[StringName]([&"storm"])

[resource]
script = ExtResource("1_s")
id = &"thunder_steppe"
display_name = "The Thunder Steppe"
order = 1
element = &"storm"
tagline = "The Sky turned on its own plains"
description = "The high grass is flattened and the storms run wild. The Sky's own horde rides the plateau, and lightning only tickles it. Earth grounds a storm."
requires_campaigns = Array[StringName]([&"ember_reach"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of Thunder"
reward_description = "Storm towers attack 8% faster in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
