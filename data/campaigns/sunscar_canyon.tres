[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"earth_1"
display_name = "Red Gulch"
description = "Dust devils and red rock. The armoured ones are slow, at least."
map = &"c_earth_1"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"earth"])

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"earth_2"
display_name = "Canyon Switchbacks"
description = "The road zigzags down the canyon wall, five long terraces."
map = &"c_earth_2"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Vholt Stormcrown, the Sky Herald (blinks, silences towers).", "Bedrock: Earth towers deal a further 10% more damage.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"starting_lives"
kind = 1
value = -0.25

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"earth_3"
display_name = "Mesa Loop"
description = "A loop around a flat-topped mesa, then a sprint for the exit."
map = &"c_earth_3"
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Rockfall: 25% fewer lives.")
first_clear_points = 3

[sub_resource type="Resource" id="r9"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
