[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"earth_1"
display_name = "Red Gulch"
description = "Dust devils and red rock. The armoured ones are slow, at least."
map = &"c_earth_1"
horde_element = &"earth"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Earth: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"earth"])

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"earth_2"
display_name = "Canyon Switchbacks"
description = "The road zigzags down the canyon wall, five long terraces."
map = &"c_earth_2"
horde_element = &"earth"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Earth: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Gorrath the Quarried, the Stone Herald (armoured, charges when wounded, breaks into boulders).", "Bedrock: Earth towers deal a further 10% more damage.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"starting_lives"
kind = 1
value = -0.25

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"earth_3"
display_name = "Mesa Loop"
description = "A loop around a flat-topped mesa, then a sprint for the exit."
map = &"c_earth_3"
horde_element = &"earth"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Earth: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Rockfall: 25% fewer lives.")
first_clear_points = 3

[sub_resource type="Resource" id="r9"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"earth_4"
display_name = "Titan's Cradle"
description = "The Mountain Titan wakes. Every hit under 22 damage bounces off its hide. Storm, big blows and burns find a way."
map = &"c_earth_4"
is_guardian = true
horde_element = &"earth"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Earth: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Earth, and fears Storm.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"earth"])

[resource]
script = ExtResource("1_s")
id = &"sunscar_canyon"
display_name = "Sunscar Canyon"
order = 4
element = &"earth"
tagline = "The Stone turned on its own canyon"
description = "The canyon's own stone has risen, and its horde pours down the walls in armour. Earth only chips it. Storm cracks the Stone."
requires_campaigns = Array[StringName]([&"frostmere"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of Stone"
reward_description = "Earth towers deal 10% increased damage in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
