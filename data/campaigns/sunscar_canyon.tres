value = 1.0

[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"earth_4"
display_name = "Titan's Cradle"
description = "The Mountain Titan wakes. Every hit under 22 damage bounces off its hide. Big blows, burns and poison find a way."
map = &"c_earth_4"
is_guardian = true
horde_element = &"storm"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Storm: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Earth, and fears Storm.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"earth"])

[resource]
script = ExtResource("1_s")
id = &"sunscar_canyon"
display_name = "Sunscar Canyon"
order = 4
element = &"earth"
tagline = "The Sky against the Stone"
description = "Storm's horde pours down the canyon walls in armour. Earth's heavy blows and shattering hits crack what lightning cannot."
requires_campaigns = Array[StringName]([&"frostmere"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of Stone"
reward_description = "Earth towers deal 10% increased damage in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
