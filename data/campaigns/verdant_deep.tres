[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"nature_1"
display_name = "Mossy Trail"
description = "Soft ground and quiet birds. The first thorn-things are slow."
map = &"c_nature_1"
horde_element = &"nature"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Nature: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"starting_lives"
kind = 0
value = 5.0

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"nature_2"
display_name = "Rootway"
description = "The road threads between the roots of trees older than the ring."
map = &"c_nature_2"
horde_element = &"nature"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Nature: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Mother Briar, the Thorn Herald (immune to effects, shields the horde, chokes towers).", "Deep roots: +5 lives.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"sell_refund"
kind = 0
value = 0.2

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"nature_3"
display_name = "Bramble Maze"
description = "Thorns everywhere. Warded beasts walk through poison as if it were rain."
map = &"c_nature_3"
horde_element = &"nature"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Nature: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Recycling: selling refunds 20% more.")
