[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"nature_4"
display_name = "Heart of the Grove"
description = "The Elder Broodmother nests in the oldest tree, shedding young as she walks. The Void will thin the brood."
map = &"c_nature_4"
is_guardian = true
horde_element = &"nature"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Nature: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Nature, and fears Void.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"nature"])

[resource]
script = ExtResource("1_s")
id = &"verdant_deep"
display_name = "The Verdant Deep"
order = 2
element = &"nature"
tagline = "The Grove turned on its own forest"
description = "The forest itself has risen against its people: thorn, bark and beast. Its Menders walk the roots at night. The Void withers what grows."
requires_campaigns = Array[StringName]([&"thunder_steppe"])
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of the Grove"
reward_description = "Nature towers deal 10% increased damage in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
