[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"ember_1"
display_name = "Ashfall Road"
description = "The first villages smoulder under a grey sky. The Tide comes in small, wet packs."
map = &"c_ember_1"
allowed_elements = Array[StringName]([&"fire", &"storm", &"void"])
starting_nodes = Array[StringName]([&"fire_entry"])
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("Home ground: Fire towers deal 20% more damage.", "Only Fire, Storm and Void can be drafted. You start with Fire.")
first_clear_points = 3

