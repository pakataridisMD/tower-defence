[gd_resource type="Resource" script_class="CampaignData" format=3]

[ext_resource type="Script" path="res://scripts/data/campaign_data.gd" id="1_s"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="2_s"]
[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="3_s"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r2"]
script = ExtResource("3_s")
id = &"ember_1"
display_name = "Ashfall Road"
description = "The first villages smoulder under a grey sky. The Tide comes in small, wet packs."
map = &"c_ember_1"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r1")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.")
first_clear_points = 3

[sub_resource type="Resource" id="r3"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r4"]
script = ExtResource("2_s")
stat = &"gold_per_wave"
kind = 0
value = 10.0

[sub_resource type="Resource" id="r5"]
script = ExtResource("3_s")
id = &"ember_2"
display_name = "Cinder Steps"
description = "Menders walk with the Tide now. Keep them burning, or they will heal."
map = &"c_ember_2"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r3"), SubResource("r4")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The last wave is led by Saltmother Ourra, the Drowned Herald (shields the horde).", "Rich veins: +10 gold after every wave.")
first_clear_points = 3

[sub_resource type="Resource" id="r6"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r7"]
script = ExtResource("2_s")
stat = &"attack_range"
kind = 1
value = -0.1

[sub_resource type="Resource" id="r8"]
script = ExtResource("3_s")
id = &"ember_3"
display_name = "Obsidian Crossing"
description = "The road crosses itself on a field of black glass. Every tower there fires twice."
map = &"c_ember_3"
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r6"), SubResource("r7")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "Ash clouds: towers have 10% less range.")
first_clear_points = 3

[sub_resource type="Resource" id="r9"]
script = ExtResource("2_s")
stat = &"starting_tree_points"
kind = 0
value = 1.0

[sub_resource type="Resource" id="r10"]
script = ExtResource("3_s")
id = &"ember_4"
display_name = "Throne of Cinders"
description = "At the caldera the Cinder Tyrant waits: the Warden of Fire, burning wrong. It shrugs off flame. Bring Storm or Void."
map = &"c_ember_4"
is_guardian = true
horde_element = &"water"
modifiers = Array[ExtResource("2_s")]([SubResource("r9")])
rule_text = PackedStringArray("The horde here is Water: find the element it fears. Every element can be drafted, and you start with one more skill point.", "The Warden is Fire, and fears Water.")
first_clear_points = 6

[sub_resource type="Resource" id="r11"]
script = ExtResource("2_s")
stat = &"damage"
kind = 1
value = 0.1
required_tags = Array[StringName]([&"fire"])

[resource]
script = ExtResource("1_s")
id = &"ember_reach"
display_name = "The Ember Reach"
order = 0
element = &"fire"
tagline = "The Tide against the Volcano"
description = "The Warden of Fire has gone silent, and the sea has come up the mountain. Hold the ash roads with flame while the Tide's Menders knit their wounds shut."
stages = Array[ExtResource("3_s")]([SubResource("r2"), SubResource("r5"), SubResource("r8"), SubResource("r10")])
reward_name = "Sigil of Embers"
reward_description = "Fire towers deal 10% increased damage in every run."
reward_modifiers = Array[ExtResource("2_s")]([SubResource("r11")])
