[resource]
script = ExtResource("1_skill")
id = &"entangle"
display_name = "Entangle"
description = "Roots burst from the ground at a point. Enemies there are held for 1 second, then slowed and poisoned. Bosses are only slowed and poisoned."
element = &"nature"
requires_node = &"nature_entry"
cooldown = 60.0
radius = 100.0
