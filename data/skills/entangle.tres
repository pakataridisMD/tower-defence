[gd_resource type="Resource" script_class="SkillData" format=3]

[ext_resource type="Script" path="res://scripts/data/skill_data.gd" id="1_skill"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="3_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
