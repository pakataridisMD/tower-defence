[resource]
script = ExtResource("1_skill")
id = &"tidal_wave"
display_name = "Tidal Wave"
description = "A wave sweeps the whole road, pushing every enemy a little way back and slowing it for 2 seconds. Bosses are pushed half as far."
element = &"water"
requires_node = &"water_entry"
cooldown = 70.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0")])
knockback = 50.0
sweep_time = 1.4
strike_gap = 1.1
ranks = Array[ExtResource("4_rank")]([SubResource("Rank_1"), SubResource("Rank_2"), SubResource("Rank_3"), SubResource("Rank_4"), SubResource("Rank_5")])
