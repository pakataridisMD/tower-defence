   "muster": [
    {
     "id": "ilyra_muster",
     "text": "I've been inside these walls. I know how they break."
    }
   ],
   "fight": [
    {
     "id": "ilyra_fight",
     "text": "You kept me in the dark for years. Now you'll see what I learned."
    }
   ],
   "siege": [
    {
     "id": "ilyra_siege",
     "text": "Down, Nhal Vorath! I'm not your prisoner anymore!"
    }
   ],
   "hurt": [
    {
     "id": "ilyra_hurt",
     "text": "[pained] I've felt worse in your cells!"
    }
   ],
   "death": [
    {
     "id": "ilyra_death",
     "text": "[whispering] Father... I'm sorry..."
    }
   ],
   "crack": [
    {
     "id": "ilyra_crack",
     "text": "It's breaking! Tear it all down!"
    }
   ]
  },
  "seraphel": {
   "muster": [
    {
     "id": "seraphel_muster",
     "text": "The Dawnblade is drawn! Into the dark!"
    }
   ],
   "fight": [
    {
     "id": "seraphel_fight",
     "text": "Sunstone light burns hollow things! Burn!"
    }
   ],
   "siege": [
    {
     "id": "seraphel_siege",
     "text": "Let the light into Nhal Vorath!"
    }
   ],
   "hurt": [
    {
     "id": "seraphel_hurt",
     "text": "[pained] The light still burns!"
    }
   ],
   "death": [
    {
     "id": "seraphel_death",
     "text": "[fading] Carry... the light..."
    }
   ],
   "crack": [
    {
     "id": "seraphel_crack",
     "text": "The walls are breaking! Shine through!"
    }
   ]
  },
  "oswin": {
   "muster": [
    {
     "id": "oswin_muster",
     "text": "I held this Gate shut with my own hands. Now we go through."
    }
   ],
   "fight": [
    {
     "id": "oswin_fight",
     "text": "Stand in my light, all of you. It holds."
    }
   ],
   "siege": [
    {
     "id": "oswin_siege",
     "text": "Old Vael was a beautiful city once. Bring down what he made of it."
    }
   ],
   "hurt": [
    {
     "id": "oswin_hurt",
     "text": "[pained, wry] I'm too old for this. Keep going!"
    }
   ],
   "death": [
    {
     "id": "oswin_death",
     "text": "[softly] Keep... the lantern lit..."
    }
   ],
   "crack": [
    {
     "id": "oswin_crack",
     "text": "There! It breaks! Don't stop!"
    }
   ]
  },
  "ignar": {
   "muster": [
    {
     "id": "ignar_muster",
     "text": "Two thousand years ago I helped shut you in here, Vael-Orrun. I've come to finish it."
    }
   ],
   "fight": [
    {
     "id": "ignar_fight",
     "text": "Burn, Unbound! Burn to ash!"
    }
   ],
   "siege": [
    {
     "id": "ignar_siege",
     "text": "Fire against stone! Melt it down!"
    }
   ],
   "hurt": [
    {
     "id": "ignar_hurt",
     "text": "[roars] You can't put out a fire like me!"
    }
   ],
   "death": [
    {
     "id": "ignar_death",
     "text": "[fading rumble] The cinders... cool..."
    }
   ],
   "crack": [
    {
     "id": "ignar_crack",
     "text": "Your house is burning, Vael!"
    }
   ]
  },
  "aurath": {
   "muster": [
    {
     "id": "aurath_muster",
     "text": "The storm has come down the Rift! Nhal Vorath will hear it!"
    }
   ],
   "fight": [
    {
     "id": "aurath_fight",
     "text": "Lightning! Take them all!"
    }
   ],
   "siege": [
    {
     "id": "aurath_siege",
     "text": "Break, walls! Break under the storm!"
    }
   ],
   "hurt": [
    {
     "id": "aurath_hurt",
     "text": "[snarls] You cannot wound the sky!"
    }
   ],
   "death": [
    {
     "id": "aurath_death",
     "text": "[fading] The storm... passes..."
    }
   ],
   "crack": [
    {
     "id": "aurath_crack",
     "text": "Thunder on your walls, Vael-Orrun!"
    }
   ]
  },
  "elowen": {
   "muster": [
    {
     "id": "elowen_muster",
     "text": "Stand up, wounded! The Evergreen is here!"
    }
   ],
   "fight": [
    {
     "id": "elowen_fight",
     "text": "Roots, hold them! Grow, and hold!"
    }
   ],
   "siege": [
    {
     "id": "elowen_siege",
     "text": "Roots break stone. Slowly, then all at once."
    }
   ],
   "hurt": [
    {
     "id": "elowen_hurt",
     "text": "[pained] I bend. I don't break."
    }
   ],
   "death": [
    {
     "id": "elowen_death",
     "text": "[softly] Plant me... somewhere green..."
    }
   ],
   "crack": [
    {
     "id": "elowen_crack",
     "text": "The roots are in the walls! It's splitting!"
    }
   ]
  },
  "thalassa": {
   "muster": [
    {
     "id": "thalassa_muster",
     "text": "The Deep has followed me down the Rift. It's hungry."
    }
   ],
   "fight": [
    {
     "id": "thalassa_fight",
     "text": "Drown in it!"
    }
   ],
   "siege": [
    {
     "id": "thalassa_siege",
     "text": "Water breaks every wall in time. Today it's quick."
    }
   ],
   "hurt": [
    {
     "id": "thalassa_hurt",
     "text": "[pained] The tide always comes back."
    }
   ],
   "death": [
    {
     "id": "thalassa_death",
     "text": "[fading] Back... to the Deep..."
    }
   ],
   "crack": [
    {
     "id": "thalassa_crack",
     "text": "The walls are breaking! Flood them!"
    }
   ]
  },
  "orrok": {
   "muster": [
    {
     "id": "orrok_muster",
     "text": "The Mountain walks. Walls of Vael, you are mine."
    }
   ],
   "fight": [
    {
     "id": "orrok_fight",
     "text": "Small things. Out of my path."
    }
   ],
   "siege": [
    {
     "id": "orrok_siege",
     "text": "I am older than these walls. I will outlast them."
    }
   ],
   "hurt": [
    {
     "id": "orrok_hurt",
     "text": "[deep rumble] A pebble against a mountain."
    }
   ],
   "death": [
    {
     "id": "orrok_death",
     "text": "[deep, fading] The mountain... sleeps..."
    }
   ],
   "crack": [
    {
     "id": "orrok_crack",
     "text": "Crumble."
    }
   ]
  },
  "nyxara": {
   "muster": [
    {
     "id": "nyxara_muster",
     "text": "I know this dark. I shut you into it myself, Vael-Orrun."
    }
   ],
   "fight": [
    {
     "id": "nyxara_fight",
     "text": "Look at me, Unbound. You can't, can you?"
    }
   ],
   "siege": [
    {
     "id": "nyxara_siege",
     "text": "Your walls were never yours, Vael. They were your prison."
    }
   ],
   "hurt": [
    {
     "id": "nyxara_hurt",
     "text": "[hisses] You'll pay for that."
    }
   ],
   "death": [
    {
     "id": "nyxara_death",
     "text": "[whispering] Into the dark... again..."
    }
   ],
   "crack": [
    {
     "id": "nyxara_crack",
     "text": "It's breaking. Your prison is breaking, Vael."
    }
   ]
  }
 }
}
