duration = 10.0
ward = true

[sub_resource type="Resource" id="S4"]
script = ExtResource("ability")
display_name = "Last Light"
description = "For 10 seconds whatever reaches the gate is thrown back to the start, and 5 lives come back."
cooldown = 120.0
target = 2
duration = 10.0
