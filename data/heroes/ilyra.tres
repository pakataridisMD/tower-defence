[resource]
script = ExtResource("hero")
id = &"ilyra"
display_name = "Ilyra the Unbroken"
title = "Daughter of the Regent"
blurb = "The Regent's lost daughter, six years in the Outer Hollow, and the reason he will be stopped."
order = 13
element = &"void"
joins_after = &"converge_1"
attack = SubResource("S2")
aura_text = "Every hero in the party fights one level higher"
aura_hero_levels = 1
ability = SubResource("S3")
ultimate = SubResource("S4")
ultimate_text = "Also heals 5 lives"
barks = PackedStringArray("I know this dark. It doesn't know me any more.", "Three heartbeats. Now.", "One of them wept. The other never did.")
