[gd_resource type="Resource" script_class="HeroData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/hero_data.gd" id="hero"]
[ext_resource type="Script" path="res://scripts/data/hero_ability.gd" id="ability"]
[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="status"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod"]
[sub_resource type="Resource" id="S1"]
script = ExtResource("tower")
id = &"aurath"
display_name = "Aurath"
description = "Lightning that leaps through three enemies."
elements = Array[StringName]([&"storm"])
tags = Array[StringName]([&"hero"])
cost = 1
damage = 6.0
attacks_per_second = 0.9
attack_range = 170.0
chain_range = 140.0
chain_falloff = 0.15
chain_count = 2

[sub_resource type="Resource" id="S2"]
script = ExtResource("ability")
display_name = "Skyfall"
description = "A season of held-back storm let go at once: lightning strikes every enemy on the board."
cooldown = 130.0
target = 2
damage = 15.0

[sub_resource type="Resource" id="S3"]
script = ExtResource("ability")
display_name = "Skyfall"
description = "Lightning strikes every enemy on the board, twice."
cooldown = 130.0
target = 2
strikes = 2
damage = 15.0

[sub_resource type="Resource" id="S4"]
script = ExtResource("mod")
stat = &"chain_count"
value = 1.0
required_tags = Array[StringName]([&"storm"])

[resource]
script = ExtResource("hero")
id = &"aurath"
display_name = "Aurath"
title = "of the Storms"
blurb = "The Warden of Storm: a rider of cloud and lightning, never quite still."
order = 8
element = &"storm"
joins_after = &"storm_4"
attack = SubResource("S1")
aura = Array[ExtResource("mod")]([SubResource("S4")])
aura_text = "Storm towers jump to 1 more enemy"
ability = SubResource("S2")
ultimate = SubResource("S3")
ultimate_text = "Strikes twice"
barks = PackedStringArray("We are the wind behind you.", "Moving! Moving!", "We remember the road.")
