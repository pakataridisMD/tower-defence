[gd_resource type="Resource" script_class="HeroData" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/data/hero_data.gd" id="hero"]
[ext_resource type="Script" path="res://scripts/data/hero_ability.gd" id="ability"]
[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="status"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod"]
[sub_resource type="Resource" id="S1"]
script = ExtResource("status")
kind = &"slow"
slow = 0.3
duration = 2.0

[sub_resource type="Resource" id="S2"]
script = ExtResource("tower")
id = &"thalassa"
display_name = "Thalassa"
description = "A jet of water that slows and pushes enemies back."
elements = Array[StringName]([&"water"])
tags = Array[StringName]([&"hero"])
cost = 1
damage = 45.0
attacks_per_second = 0.9
attack_range = 200.0
knockback = 30.0
status_effects = Array[ExtResource("status")]([SubResource("S1")])

[sub_resource type="Resource" id="S3"]
script = ExtResource("ability")
display_name = "Great Flood"
description = "The tide comes in: every enemy but the bosses is swept back to the start of its road."
cooldown = 90.0
target = 2
send_to_start = true

[sub_resource type="Resource" id="S4"]
script = ExtResource("ability")
display_name = "Great Flood"
description = "The tide comes in: every enemy, bosses too, is swept back to the start of its road."
cooldown = 90.0
target = 2
send_to_start = true
send_bosses = true

[sub_resource type="Resource" id="S5"]
script = ExtResource("mod")
stat = &"attack_range"
kind = 1
value = 0.25
required_tags = Array[StringName]([&"water"])

[sub_resource type="Resource" id="S6"]
script = ExtResource("mod")
stat = &"attack_range"
kind = 1
value = 0.1

[resource]
script = ExtResource("hero")
id = &"thalassa"
display_name = "Thalassa"
title = "of the Deep"
blurb = "The Warden of Water, who remembers everything."
order = 10
element = &"water"
joins_after = &"water_4"
attack = SubResource("S2")
aura = Array[ExtResource("mod")]([SubResource("S5"), SubResource("S6")])
aura_text = "+10% range, and +25% more for water towers"
ability = SubResource("S3")
ultimate = SubResource("S4")
ultimate_text = "Bosses are swept back too"
barks = PackedStringArray("I remember.", "Be still, and sink.", "Every one of you. Every one.")
