[resource]
script = ExtResource("hero")
id = &"oswin"
display_name = "Oswin the White Lantern"
title = "Master of the Order of the Spire"
blurb = "The Grey Lantern, back from the road of the dead with the light of every fallen city."
order = 15
arrives_in = &"converge_3"
arrives_at_wave = 17
attack = SubResource("S1")
aura = Array[ExtResource("mod")]([SubResource("S4"), SubResource("S5")])
aura_text = "+12% damage and +5% range"
ability = SubResource("S2")
ultimate = SubResource("S3")
ultimate_text = "Every other hero's ability is ready again"
barks = PackedStringArray("Light's on. Let's go.", "Every light you lost, I kept.", "A long way round. Worth it.")
