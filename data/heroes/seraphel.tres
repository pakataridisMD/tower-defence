[resource]
script = ExtResource("hero")
id = &"seraphel"
display_name = "Seraphel the Dawnblade"
title = "Knight of the Sunstone"
blurb = "The last knight of the Sunstone, who has one fight left in her."
order = 14
joins_after = &"converge_2"
attack = SubResource("S1")
aura = Array[ExtResource("mod")]([SubResource("S4"), SubResource("S5")])
aura_text = "+15% damage and attack speed"
ability = SubResource("S2")
ultimate = SubResource("S3")
ultimate_text = "Every skill is ready again"
barks = PackedStringArray("Stand in the light.", "I have seen worse. Not much worse.", "For the Sunstone. For the dawn.")
