attacks_per_second = 1.2
attack_range = 200.0
projectile_speed = 800.0
splash_radius = 60.0

[sub_resource type="Resource" id="S2"]
script = ExtResource("ability")
display_name = "Dawnbreak"
description = "A beam of the Sunstone's light down every road, in each enemy's weakest element."
cooldown = 60.0
target = 2
damage = 220.0
hits_weakness = true

[sub_resource type="Resource" id="S3"]
script = ExtResource("ability")
display_name = "Dawnbreak"
description = "A beam down every road in each enemy's weakest element, and every skill is ready again."
cooldown = 60.0
target = 2
damage = 220.0
hits_weakness = true
