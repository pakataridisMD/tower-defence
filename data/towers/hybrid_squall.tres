[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_e0"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.25
duration = 1.5

[sub_resource type="Resource" id="Asc_monsoon_m0"]
script = ExtResource("mod_script")
stat = &"slow_strength"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_monsoon_m1"]
script = ExtResource("mod_script")
stat = &"slow_duration"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_monsoon"]
script = ExtResource("asc_script")
id = &"monsoon"
display_name = "Monsoon"
description = "Slows are 50% stronger and last 50% longer."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_monsoon_m0"), SubResource("Asc_monsoon_m1")])

[sub_resource type="Resource" id="Asc_hailstorm_m0"]
script = ExtResource("mod_script")
stat = &"chain_count"
value = 2.0

[sub_resource type="Resource" id="Asc_hailstorm_m1"]
script = ExtResource("mod_script")
stat = &"damage"
kind = 2
value = 0.3

[sub_resource type="Resource" id="Asc_hailstorm"]
script = ExtResource("asc_script")
id = &"hailstorm"
display_name = "Hailstorm"
description = "Bolts chain to 2 more enemies and deal 30% more damage."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_hailstorm_m0"), SubResource("Asc_hailstorm_m1")])

[resource]
script = ExtResource("1_tower")
id = &"hybrid_squall"
display_name = "Squall"
description = "Freezing rain and lightning: bolts chain through the wave and slow it."
elements = Array[StringName]([&"storm", &"water"])
cost = 150
damage = 9.0
attacks_per_second = 1.3
attack_range = 180.0
chain_count = 3
chain_range = 120.0
chain_falloff = 0.15
status_effects = Array[ExtResource("2_status")]([SubResource("Resource_e0")])
requires_nodes = Array[StringName]([&"storm_core", &"water_core"])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_monsoon"), SubResource("Asc_hailstorm")])
