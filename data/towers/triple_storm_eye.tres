[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.3
duration = 2.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.2
duration = 3.0

[sub_resource type="Resource" id="Asc_cyclone_m0"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 3.0

[sub_resource type="Resource" id="Asc_cyclone_m1"]
script = ExtResource("4_mod")
stat = &"knockback"
value = 8.0

[sub_resource type="Resource" id="Asc_cyclone"]
script = ExtResource("3_asc")
id = &"cyclone"
display_name = "Cyclone"
description = "Chains to 3 more enemies and pushes them back 8 further."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_cyclone_m0"), SubResource("Asc_cyclone_m1")])

[sub_resource type="Resource" id="Asc_dead_calm_m0"]
script = ExtResource("4_mod")
stat = &"slow_strength"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_dead_calm_m1"]
script = ExtResource("4_mod")
stat = &"curse_strength"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_dead_calm"]
script = ExtResource("3_asc")
id = &"dead_calm"
display_name = "Dead Calm"
description = "Slows are 50% stronger and curses 60% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_dead_calm_m0"), SubResource("Asc_dead_calm_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_storm_eye"
display_name = "Eye of the Storm"
description = "A calm and terrible eye: long chains that slow and curse, pushing the wave back."
elements = Array[StringName]([&"storm", &"water", &"void"])
cost = 320
damage = 14.0
attacks_per_second = 1.4
attack_range = 195.0
chain_count = 5
chain_range = 140.0
chain_falloff = 0.1
knockback = 8.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_cyclone"), SubResource("Asc_dead_calm")])
