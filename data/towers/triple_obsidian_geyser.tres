[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 9.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.35
duration = 2.0

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 2.0
duration = 5.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("2_status")
kind = &"stun"
duration = 0.3

[sub_resource type="Resource" id="Asc_glass_storm_m0"]
script = ExtResource("4_mod")
stat = &"splash_radius"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_glass_storm_m1"]
script = ExtResource("4_mod")
stat = &"shatter_strength"
kind = 1
value = 1.0

[sub_resource type="Resource" id="Asc_glass_storm"]
script = ExtResource("3_asc")
id = &"glass_storm"
display_name = "Glass Storm"
description = "Splashes 50% wider and shatter is twice as strong."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_glass_storm_m0"), SubResource("Asc_glass_storm_m1")])

[sub_resource type="Resource" id="Asc_caldera_heart_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_caldera_heart_m1"]
script = ExtResource("4_mod")
stat = &"stun_duration"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_caldera_heart"]
script = ExtResource("3_asc")
id = &"caldera_heart"
display_name = "Caldera Heart"
description = "Deals double damage and stuns last 60% longer."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_caldera_heart_m0"), SubResource("Asc_caldera_heart_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_obsidian_geyser"
display_name = "Obsidian Geyser"
description = "Erupts in shards of volcanic glass: burns, slows, stuns and tears armour apart."
elements = Array[StringName]([&"fire", &"water", &"earth"])
tags = Array[StringName]([&"area"])
cost = 340
damage = 42.0
attacks_per_second = 0.5
attack_range = 165.0
projectile_speed = 420.0
splash_radius = 80.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_glass_storm"), SubResource("Asc_caldera_heart")])
