[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.35
duration = 2.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"stun"
duration = 0.35

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.2
duration = 3.0

[sub_resource type="Resource" id="Asc_undertow_king_m0"]
script = ExtResource("4_mod")
stat = &"knockback"
value = 24.0

[sub_resource type="Resource" id="Asc_undertow_king_m1"]
script = ExtResource("4_mod")
stat = &"splash_radius"
kind = 1
value = 0.3

[sub_resource type="Resource" id="Asc_undertow_king"]
script = ExtResource("3_asc")
id = &"undertow_king"
display_name = "Undertow King"
description = "Drags enemies back 24 further and the collapse is 30% wider."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_undertow_king_m0"), SubResource("Asc_undertow_king_m1")])

[sub_resource type="Resource" id="Asc_crushing_depth_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_crushing_depth_m1"]
script = ExtResource("4_mod")
stat = &"curse_strength"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_crushing_depth"]
script = ExtResource("3_asc")
id = &"crushing_depth"
display_name = "Crushing Depth"
description = "Deals double damage and curses are 50% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_crushing_depth_m0"), SubResource("Asc_crushing_depth_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_abyssal_trench"
display_name = "Abyssal Trench"
description = "Opens the deep under their feet: the whole group is dragged back, stunned and cursed."
elements = Array[StringName]([&"water", &"earth", &"void"])
requires_nodes = Array[StringName]([&"water_core", &"earth_core", &"void_core"])
tags = Array[StringName]([&"area"])
cost = 300
damage = 34.0
attacks_per_second = 0.5
attack_range = 170.0
projectile_speed = 380.0
splash_radius = 70.0
knockback = 30.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_undertow_king"), SubResource("Asc_crushing_depth")])
