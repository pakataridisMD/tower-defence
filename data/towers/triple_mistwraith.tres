[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 8.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.3
duration = 2.0

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.25
duration = 3.0

[sub_resource type="Resource" id="Asc_shroud_m0"]
script = ExtResource("4_mod")
stat = &"aura_radius"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_shroud_m1"]
script = ExtResource("4_mod")
stat = &"aura_damage"
value = 0.1

[sub_resource type="Resource" id="Asc_shroud"]
script = ExtResource("3_asc")
id = &"shroud"
display_name = "Shroud"
description = "The aura reaches 40% further and grants 10% more increased damage."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_shroud_m0"), SubResource("Asc_shroud_m1")])

[sub_resource type="Resource" id="Asc_banshee_m0"]
script = ExtResource("4_mod")
stat = &"curse_strength"
kind = 1
value = 0.8

[sub_resource type="Resource" id="Asc_banshee_m1"]
script = ExtResource("4_mod")
stat = &"burn_damage"
kind = 2
value = 0.6

[sub_resource type="Resource" id="Asc_banshee"]
script = ExtResource("3_asc")
id = &"banshee"
display_name = "Banshee"
description = "Curses are 80% stronger and burn deals 60% more damage."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_banshee_m0"), SubResource("Asc_banshee_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_mistwraith"
display_name = "Mistwraith"
description = "A haunted fog bank: it scalds and curses all inside it, and veils nearby towers in power."
elements = Array[StringName]([&"fire", &"water", &"void"])
requires_nodes = Array[StringName]([&"fire_core", &"water_core", &"void_core"])
tags = Array[StringName]([&"area"])
cost = 340
damage = 20.0
attacks_per_second = 0.8
attack_range = 165.0
projectile_speed = 500.0
splash_radius = 90.0
aura_radius = 150.0
aura_damage = 0.2
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_shroud"), SubResource("Asc_banshee")])
