[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_gujvr"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_7gt7k"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_exyxr"]
script = ExtResource("2_7gt7k")
kind = &"burn"
damage_per_second = 4.0
duration = 3.0
max_stacks = 5

[sub_resource type="Resource" id="Asc_pyre_m0"]
script = ExtResource("mod_script")
stat = &"splash_radius"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_pyre_m1"]
script = ExtResource("mod_script")
stat = &"damage"
kind = 2
value = 0.2

[sub_resource type="Resource" id="Asc_pyre"]
script = ExtResource("asc_script")
id = &"pyre"
display_name = "Pyre"
description = "Fireballs splash 60% wider and deal 20% more damage."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_pyre_m0"), SubResource("Asc_pyre_m1")])

[sub_resource type="Resource" id="Asc_hearth_m0"]
script = ExtResource("mod_script")
