[sub_resource type="Resource" id="Asc_hearth"]
script = ExtResource("asc_script")
id = &"hearth"
display_name = "Hearth"
description = "Burn deals double damage and stacks 3 more times."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_hearth_m0"), SubResource("Asc_hearth_m1")])

[resource]
script = ExtResource("1_gujvr")
id = &"fire_brazier"
display_name = "Brazier"
description = "Lobs fireballs that burn every enemy in a small area."
elements = Array[StringName]([&"fire"])
tags = Array[StringName]([&"area"])
damage = 8.0
projectile_speed = 500.0
splash_radius = 60.0
status_effects = Array[ExtResource("2_7gt7k")]([SubResource("Resource_exyxr")])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_pyre"), SubResource("Asc_hearth")])
