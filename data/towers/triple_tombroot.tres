[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 10.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 2.0
duration = 5.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.25
duration = 3.0

[sub_resource type="Resource" id="Asc_grave_harvest_m0"]
script = ExtResource("4_mod")
stat = &"bounty_bonus"
value = 3.0

[sub_resource type="Resource" id="Asc_grave_harvest_m1"]
script = ExtResource("4_mod")
stat = &"poison_spread_count"
value = 3.0

[sub_resource type="Resource" id="Asc_grave_harvest"]
script = ExtResource("3_asc")
id = &"grave_harvest"
display_name = "Grave Harvest"
description = "Kills earn 3 more gold and poison spreads to 3 more enemies on death."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_grave_harvest_m0"), SubResource("Asc_grave_harvest_m1")])

[sub_resource type="Resource" id="Asc_bone_spear_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_bone_spear_m1"]
script = ExtResource("4_mod")
stat = &"shatter_strength"
kind = 1
value = 1.0

[sub_resource type="Resource" id="Asc_bone_spear"]
script = ExtResource("3_asc")
id = &"bone_spear"
display_name = "Bone Spear"
description = "Deals double damage and shatter is twice as strong."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_bone_spear_m0"), SubResource("Asc_bone_spear_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_tombroot"
display_name = "Tombroot"
description = "Roots through a graveyard: heavy cursed thorns that shatter armour and feed on the dead."
elements = Array[StringName]([&"nature", &"earth", &"void"])
cost = 340
damage = 46.0
attacks_per_second = 0.7
attack_range = 175.0
projectile_speed = 700.0
bounty_bonus = 2
poison_spread_count = 2
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_grave_harvest"), SubResource("Asc_bone_spear")])
