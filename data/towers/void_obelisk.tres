[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_e0"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.15
duration = 3.0

[sub_resource type="Resource" id="Asc_beacon_m0"]
script = ExtResource("mod_script")
stat = &"aura_radius"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_beacon_m1"]
script = ExtResource("mod_script")
stat = &"aura_damage"
value = 0.1

[sub_resource type="Resource" id="Asc_beacon"]
script = ExtResource("asc_script")
id = &"beacon"
display_name = "Dark Beacon"
description = "The aura reaches 40% further and grants 10% more increased damage."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_beacon_m0"), SubResource("Asc_beacon_m1")])

[sub_resource type="Resource" id="Asc_hex_m0"]
script = ExtResource("mod_script")
stat = &"curse_strength"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_hex_m1"]
script = ExtResource("mod_script")
stat = &"curse_duration"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_hex"]
script = ExtResource("asc_script")
id = &"hex"
display_name = "Hex"
description = "Curses are 60% stronger and last 50% longer."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_hex_m0"), SubResource("Asc_hex_m1")])

[resource]
script = ExtResource("1_tower")
id = &"void_obelisk"
display_name = "Obelisk"
description = "Curses enemies to take more damage and empowers nearby towers."
elements = Array[StringName]([&"void"])
tags = Array[StringName]([&"support"])
cost = 65
damage = 5.0
attacks_per_second = 1.0
attack_range = 150.0
projectile_speed = 650.0
aura_radius = 140.0
aura_damage = 0.15
status_effects = Array[ExtResource("2_status")]([SubResource("Resource_e0")])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_beacon"), SubResource("Asc_hex")])
