[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 8.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"stun"
duration = 0.3

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 1.5
duration = 5.0
max_stacks = 5

[sub_resource type="Resource" id="Asc_anvil_of_storms_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_anvil_of_storms_m1"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = -1.0

[sub_resource type="Resource" id="Asc_anvil_of_storms"]
script = ExtResource("3_asc")
id = &"anvil_of_storms"
display_name = "Anvil of Storms"
description = "Deals double damage but chains to 1 fewer enemy."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_anvil_of_storms_m0"), SubResource("Asc_anvil_of_storms_m1")])

[sub_resource type="Resource" id="Asc_forge_lightning_m0"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 3.0

[sub_resource type="Resource" id="Asc_forge_lightning_m1"]
script = ExtResource("4_mod")
stat = &"chain_falloff"
kind = 2
value = -1.0

[sub_resource type="Resource" id="Asc_forge_lightning"]
script = ExtResource("3_asc")
id = &"forge_lightning"
display_name = "Forge Lightning"
description = "Chains to 3 more enemies and loses no damage as it jumps."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_forge_lightning_m0"), SubResource("Asc_forge_lightning_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_thunderforge"
display_name = "Thunderforge"
description = "A hammer of lightning on a molten anvil: heavy chains that burn, stun and shatter."
elements = Array[StringName]([&"fire", &"storm", &"earth"])
requires_nodes = Array[StringName]([&"fire_core", &"storm_core", &"earth_core"])
cost = 340
damage = 34.0
attacks_per_second = 0.8
attack_range = 185.0
chain_count = 4
chain_range = 135.0
chain_falloff = 0.1
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_anvil_of_storms"), SubResource("Asc_forge_lightning")])
