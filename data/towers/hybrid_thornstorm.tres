[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_kit8m"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_rqedx"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_sgn4s"]
script = ExtResource("2_rqedx")
kind = &"poison"
damage_per_second = 4.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Asc_swarm_m0"]
script = ExtResource("mod_script")
stat = &"attacks_per_second"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_swarm_m1"]
script = ExtResource("mod_script")
stat = &"chain_count"
value = 1.0

[sub_resource type="Resource" id="Asc_swarm"]
script = ExtResource("asc_script")
id = &"swarm"
display_name = "Swarm"
description = "Attacks 40% faster and chains to 1 more enemy."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_swarm_m0"), SubResource("Asc_swarm_m1")])

[sub_resource type="Resource" id="Asc_venom_gale_m0"]
script = ExtResource("mod_script")
stat = &"poison_damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_venom_gale_m1"]
script = ExtResource("mod_script")
stat = &"poison_spread_count"
value = 2.0

[sub_resource type="Resource" id="Asc_venom_gale"]
script = ExtResource("asc_script")
id = &"venom_gale"
display_name = "Venom Gale"
description = "Poison deals double damage and spreads to 2 enemies on death."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_venom_gale_m0"), SubResource("Asc_venom_gale_m1")])

[resource]
script = ExtResource("1_kit8m")
id = &"hybrid_thornstorm"
display_name = "Thornstorm"
description = "Volleys of poisoned thorns that bounce between enemies."
elements = Array[StringName]([&"storm", &"nature"])
cost = 130
damage = 6.0
attacks_per_second = 2.0
attack_range = 170.0
chain_count = 2
chain_range = 110.0
chain_falloff = 0.25
status_effects = Array[ExtResource("2_rqedx")]([SubResource("Resource_sgn4s")])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_swarm"), SubResource("Asc_venom_gale")])
