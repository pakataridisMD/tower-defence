[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 8.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 8.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.35
duration = 2.0

[sub_resource type="Resource" id="Asc_fever_swamp_m0"]
script = ExtResource("4_mod")
stat = &"burn_damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_fever_swamp_m1"]
script = ExtResource("4_mod")
stat = &"poison_damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_fever_swamp"]
script = ExtResource("3_asc")
id = &"fever_swamp"
display_name = "Fever Swamp"
description = "Burn and poison deal 80% more damage."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_fever_swamp_m0"), SubResource("Asc_fever_swamp_m1")])

[sub_resource type="Resource" id="Asc_tar_cauldron_m0"]
script = ExtResource("4_mod")
stat = &"splash_radius"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_tar_cauldron_m1"]
script = ExtResource("4_mod")
stat = &"slow_strength"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_tar_cauldron"]
script = ExtResource("3_asc")
id = &"tar_cauldron"
display_name = "Tar Cauldron"
description = "Splashes 40% wider and slows are 40% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_tar_cauldron_m0"), SubResource("Asc_tar_cauldron_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_boiling_marsh"
display_name = "Boiling Marsh"
description = "A cauldron of swamp gas: wide scalding splashes that burn, poison and slow."
elements = Array[StringName]([&"fire", &"nature", &"water"])
requires_nodes = Array[StringName]([&"fire_core", &"nature_core", &"water_core"])
tags = Array[StringName]([&"area"])
cost = 340
damage = 24.0
attacks_per_second = 0.7
attack_range = 160.0
projectile_speed = 450.0
splash_radius = 95.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_fever_swamp"), SubResource("Asc_tar_cauldron")])
