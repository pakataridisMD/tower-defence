[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 8.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"stun"
duration = 0.3

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 1.0
duration = 5.0
max_stacks = 4

[sub_resource type="Resource" id="Asc_golden_age_m0"]
script = ExtResource("4_mod")
stat = &"bounty_bonus"
value = 3.0

[sub_resource type="Resource" id="Asc_golden_age_m1"]
script = ExtResource("4_mod")
stat = &"attack_range"
kind = 1
value = 0.2

[sub_resource type="Resource" id="Asc_golden_age"]
script = ExtResource("3_asc")
id = &"golden_age"
display_name = "Golden Age"
description = "Kills earn 3 more gold and range is 20% longer."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_golden_age_m0"), SubResource("Asc_golden_age_m1")])

[sub_resource type="Resource" id="Asc_fossil_venom_m0"]
script = ExtResource("4_mod")
stat = &"poison_damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_fossil_venom_m1"]
script = ExtResource("4_mod")
stat = &"poison_spread_count"
value = 3.0

[sub_resource type="Resource" id="Asc_fossil_venom"]
script = ExtResource("3_asc")
id = &"fossil_venom"
display_name = "Fossil Venom"
description = "Poison deals double damage and spreads to 3 enemies on death."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_fossil_venom_m0"), SubResource("Asc_fossil_venom_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_amber_spire"
display_name = "Amber Spire"
description = "Lightning trapped in ancient amber: chains that poison and stun, and pay out in gold."
elements = Array[StringName]([&"storm", &"nature", &"earth"])
requires_nodes = Array[StringName]([&"storm_core", &"nature_core", &"earth_core"])
cost = 340
damage = 26.0
attacks_per_second = 0.9
attack_range = 185.0
chain_count = 4
chain_range = 135.0
chain_falloff = 0.1
bounty_bonus = 2
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_golden_age"), SubResource("Asc_fossil_venom")])
