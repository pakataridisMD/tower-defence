[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.35
duration = 2.0

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"stun"
duration = 0.3

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 1.0
duration = 5.0
max_stacks = 4

[sub_resource type="Resource" id="Asc_spring_tide_m0"]
script = ExtResource("4_mod")
stat = &"knockback"
value = 14.0

[sub_resource type="Resource" id="Asc_spring_tide_m1"]
script = ExtResource("4_mod")
stat = &"slow_strength"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_spring_tide"]
script = ExtResource("3_asc")
id = &"spring_tide"
display_name = "Spring Tide"
description = "Pushes enemies back 14 further and slows are 40% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_spring_tide_m0"), SubResource("Asc_spring_tide_m1")])

[sub_resource type="Resource" id="Asc_overload_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_overload_m1"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 2.0

[sub_resource type="Resource" id="Asc_overload"]
script = ExtResource("3_asc")
id = &"overload"
display_name = "Overload"
description = "Deals 80% more damage and chains to 2 more enemies."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_overload_m0"), SubResource("Asc_overload_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_tidal_dynamo"
display_name = "Tidal Dynamo"
description = "A tide-driven engine: surging chains that slow, stun and hurl enemies back."
elements = Array[StringName]([&"storm", &"water", &"earth"])
cost = 340
damage = 24.0
attacks_per_second = 1.0
attack_range = 185.0
chain_count = 4
chain_range = 135.0
chain_falloff = 0.1
knockback = 14.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_spring_tide"), SubResource("Asc_overload")])
