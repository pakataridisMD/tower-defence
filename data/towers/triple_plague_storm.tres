[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 9.0
duration = 5.0
max_stacks = 6

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.2
duration = 3.0

[sub_resource type="Resource" id="Asc_pandemic_m0"]
script = ExtResource("4_mod")
stat = &"poison_damage"
kind = 2
value = 0.6

[sub_resource type="Resource" id="Asc_pandemic_m1"]
script = ExtResource("4_mod")
stat = &"poison_spread_count"
value = 4.0

[sub_resource type="Resource" id="Asc_pandemic"]
script = ExtResource("3_asc")
id = &"pandemic"
display_name = "Pandemic"
description = "Poison deals 60% more damage and spreads to 4 more enemies on death."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_pandemic_m0"), SubResource("Asc_pandemic_m1")])

[sub_resource type="Resource" id="Asc_black_lightning_m0"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 3.0

[sub_resource type="Resource" id="Asc_black_lightning_m1"]
script = ExtResource("4_mod")
stat = &"curse_strength"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_black_lightning"]
script = ExtResource("3_asc")
id = &"black_lightning"
display_name = "Black Lightning"
description = "Chains to 3 more enemies and curses are 60% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_black_lightning_m0"), SubResource("Asc_black_lightning_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_plague_storm"
display_name = "Plague Storm"
description = "A cursed stormfront raining pestilence: chains of poison that spread from the dead."
elements = Array[StringName]([&"storm", &"nature", &"void"])
requires_nodes = Array[StringName]([&"storm_core", &"nature_core", &"void_core"])
cost = 340
damage = 12.0
attacks_per_second = 1.4
attack_range = 185.0
chain_count = 4
chain_range = 135.0
chain_falloff = 0.15
poison_spread_count = 3
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_pandemic"), SubResource("Asc_black_lightning")])
