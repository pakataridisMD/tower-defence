[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 8.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.4
duration = 2.5

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 2.0
duration = 5.0
max_stacks = 4

[sub_resource type="Resource" id="Asc_sinking_earth_m0"]
script = ExtResource("4_mod")
stat = &"splash_radius"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_sinking_earth_m1"]
script = ExtResource("4_mod")
stat = &"slow_strength"
kind = 1
value = 0.3

[sub_resource type="Resource" id="Asc_sinking_earth"]
script = ExtResource("3_asc")
id = &"sinking_earth"
display_name = "Sinking Earth"
description = "Splashes 40% wider and slows are 30% stronger."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_sinking_earth_m0"), SubResource("Asc_sinking_earth_m1")])

[sub_resource type="Resource" id="Asc_ancient_rot_m0"]
script = ExtResource("4_mod")
stat = &"poison_damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_ancient_rot_m1"]
script = ExtResource("4_mod")
stat = &"shatter_strength"
kind = 1
value = 1.0

[sub_resource type="Resource" id="Asc_ancient_rot"]
script = ExtResource("3_asc")
id = &"ancient_rot"
display_name = "Ancient Rot"
description = "Poison deals double damage and shatter is twice as strong."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_ancient_rot_m0"), SubResource("Asc_ancient_rot_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_mire_colossus"
display_name = "Mire Colossus"
description = "A walking swamp of stone and root: crushing splashes that poison, slow and crack armour."
elements = Array[StringName]([&"nature", &"water", &"earth"])
tags = Array[StringName]([&"area"])
cost = 300
damage = 30.0
attacks_per_second = 0.6
attack_range = 165.0
projectile_speed = 400.0
splash_radius = 80.0
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_sinking_earth"), SubResource("Asc_ancient_rot")])
