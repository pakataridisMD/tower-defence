[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_e0"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 9.0
duration = 5.0
max_stacks = 6

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.2
duration = 3.0

[sub_resource type="Resource" id="Asc_pestilence_m0"]
script = ExtResource("mod_script")
stat = &"poison_damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_pestilence_m1"]
script = ExtResource("mod_script")
stat = &"poison_spread_count"
value = 3.0

[sub_resource type="Resource" id="Asc_pestilence"]
script = ExtResource("asc_script")
id = &"pestilence"
display_name = "Pestilence"
description = "Poison deals 80% more damage and spreads to 3 more enemies on death."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_pestilence_m0"), SubResource("Asc_pestilence_m1")])

[sub_resource type="Resource" id="Asc_deathbloom_m0"]
script = ExtResource("mod_script")
stat = &"curse_strength"
kind = 1
value = 0.6

[sub_resource type="Resource" id="Asc_deathbloom_m1"]
script = ExtResource("mod_script")
stat = &"curse_duration"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_deathbloom"]
script = ExtResource("asc_script")
id = &"deathbloom"
display_name = "Deathbloom"
description = "Curses are 60% stronger and last 50% longer."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_deathbloom_m0"), SubResource("Asc_deathbloom_m1")])

[resource]
script = ExtResource("1_tower")
id = &"hybrid_blightroot"
display_name = "Blightroot"
description = "Life and death entwined: a cursed poison that spreads from every corpse."
elements = Array[StringName]([&"nature", &"void"])
cost = 210
damage = 6.0
attacks_per_second = 1.1
attack_range = 170.0
projectile_speed = 650.0
poison_spread_count = 3
status_effects = Array[ExtResource("2_status")]([SubResource("Resource_e0"), SubResource("Resource_e1")])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_pestilence"), SubResource("Asc_deathbloom")])
