[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 8.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"curse"
damage_taken = 0.2
duration = 3.0

[sub_resource type="Resource" id="Asc_constellation_m0"]
script = ExtResource("4_mod")
stat = &"aura_radius"
kind = 1
value = 0.4

[sub_resource type="Resource" id="Asc_constellation_m1"]
script = ExtResource("4_mod")
stat = &"aura_damage"
value = 0.1

[sub_resource type="Resource" id="Asc_constellation"]
script = ExtResource("3_asc")
id = &"constellation"
display_name = "Constellation"
description = "The aura reaches 40% further and grants 10% more increased damage."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_constellation_m0"), SubResource("Asc_constellation_m1")])

[sub_resource type="Resource" id="Asc_supernova_m0"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 3.0

[sub_resource type="Resource" id="Asc_supernova_m1"]
script = ExtResource("4_mod")
stat = &"burn_damage"
kind = 2
value = 1.0

[sub_resource type="Resource" id="Asc_supernova"]
script = ExtResource("3_asc")
id = &"supernova"
display_name = "Supernova"
description = "Chains to 3 more enemies and burn deals double damage."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_supernova_m0"), SubResource("Asc_supernova_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_starfall"
display_name = "Starfall"
description = "Pulls burning stars from the void: cursed chains of fire, and an aura that empowers every tower nearby."
elements = Array[StringName]([&"void", &"fire", &"storm"])
requires_nodes = Array[StringName]([&"void_core", &"fire_core", &"storm_core"])
cost = 300
damage = 18.0
attacks_per_second = 1.2
attack_range = 190.0
chain_count = 3
chain_range = 140.0
chain_falloff = 0.15
aura_radius = 150.0
aura_damage = 0.2
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_constellation"), SubResource("Asc_supernova")])
