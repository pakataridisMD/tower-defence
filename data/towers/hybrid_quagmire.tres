[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="asc_script"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="mod_script"]

[sub_resource type="Resource" id="Resource_e0"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.45
duration = 2.5

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 2.0
duration = 5.0
max_stacks = 4

[sub_resource type="Resource" id="Asc_tar_pit_m0"]
script = ExtResource("mod_script")
stat = &"slow_duration"
kind = 1
value = 1.0

[sub_resource type="Resource" id="Asc_tar_pit_m1"]
script = ExtResource("mod_script")
stat = &"slow_strength"
kind = 1
value = 0.2

[sub_resource type="Resource" id="Asc_tar_pit"]
script = ExtResource("asc_script")
id = &"tar_pit"
display_name = "Tar Pit"
description = "Slows last twice as long and are 20% stronger."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_tar_pit_m0"), SubResource("Asc_tar_pit_m1")])

[sub_resource type="Resource" id="Asc_rockslide_m0"]
script = ExtResource("mod_script")
stat = &"damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_rockslide_m1"]
script = ExtResource("mod_script")
stat = &"shatter_strength"
kind = 1
value = 1.0

[sub_resource type="Resource" id="Asc_rockslide"]
script = ExtResource("asc_script")
id = &"rockslide"
display_name = "Rockslide"
description = "Deals 80% more damage and shatters twice as much armour."
modifiers = Array[ExtResource("mod_script")]([SubResource("Asc_rockslide_m0"), SubResource("Asc_rockslide_m1")])

[resource]
script = ExtResource("1_tower")
id = &"hybrid_quagmire"
display_name = "Quagmire"
description = "Turns the ground to sucking mud: heavy splashes that slow and crack armour."
elements = Array[StringName]([&"water", &"earth"])
tags = Array[StringName]([&"area"])
cost = 140
damage = 14.0
attacks_per_second = 0.6
attack_range = 160.0
projectile_speed = 380.0
splash_radius = 70.0
status_effects = Array[ExtResource("2_status")]([SubResource("Resource_e0"), SubResource("Resource_e1")])
ascendancies = Array[ExtResource("asc_script")]([SubResource("Asc_tar_pit"), SubResource("Asc_rockslide")])
