[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 9.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"poison"
damage_per_second = 8.0
duration = 4.0
max_stacks = 5

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_status")
kind = &"shatter"
armour_reduction = 1.5
duration = 5.0
max_stacks = 5

[sub_resource type="Resource" id="Asc_eruption_m0"]
script = ExtResource("4_mod")
stat = &"splash_radius"
kind = 1
value = 0.5

[sub_resource type="Resource" id="Asc_eruption_m1"]
script = ExtResource("4_mod")
stat = &"burn_spread_radius"
value = 90.0

[sub_resource type="Resource" id="Asc_eruption"]
script = ExtResource("3_asc")
id = &"eruption"
display_name = "Eruption"
description = "Splashes 50% wider and burn leaps to enemies within 90 when its victim dies."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_eruption_m0"), SubResource("Asc_eruption_m1")])

[sub_resource type="Resource" id="Asc_heartwood_m0"]
script = ExtResource("4_mod")
stat = &"burn_damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_heartwood_m1"]
script = ExtResource("4_mod")
stat = &"poison_damage"
kind = 2
value = 0.8

[sub_resource type="Resource" id="Asc_heartwood_m2"]
script = ExtResource("4_mod")
stat = &"bounty_bonus"
value = 2.0

[sub_resource type="Resource" id="Asc_heartwood"]
script = ExtResource("3_asc")
id = &"heartwood"
display_name = "Heartwood"
description = "Burn and poison deal 80% more damage and kills earn 2 more gold."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_heartwood_m0"), SubResource("Asc_heartwood_m1"), SubResource("Asc_heartwood_m2")])

[resource]
script = ExtResource("1_tower")
id = &"triple_worldforge"
display_name = "Worldforge"
description = "The living mountain: eruptions of magma and thorn that burn, poison and shatter."
elements = Array[StringName]([&"fire", &"nature", &"earth"])
tags = Array[StringName]([&"area"])
cost = 320
damage = 36.0
attacks_per_second = 0.55
attack_range = 170.0
projectile_speed = 400.0
splash_radius = 85.0
bounty_bonus = 1
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1"), SubResource("Effect_2")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_eruption"), SubResource("Asc_heartwood")])
