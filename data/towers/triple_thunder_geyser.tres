[gd_resource type="Resource" script_class="TowerData" format=3]

[ext_resource type="Script" path="res://scripts/data/tower_data.gd" id="1_tower"]
[ext_resource type="Script" path="res://scripts/data/status_effect_data.gd" id="2_status"]
[ext_resource type="Script" path="res://scripts/data/ascendancy_data.gd" id="3_asc"]
[ext_resource type="Script" path="res://scripts/data/modifier.gd" id="4_mod"]

[sub_resource type="Resource" id="Effect_0"]
script = ExtResource("2_status")
kind = &"burn"
damage_per_second = 9.0
duration = 3.0
max_stacks = 4

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_status")
kind = &"slow"
slow = 0.35
duration = 2.0

[sub_resource type="Resource" id="Asc_pressure_cooker_m0"]
script = ExtResource("4_mod")
stat = &"damage"
kind = 2
value = 0.7

[sub_resource type="Resource" id="Asc_pressure_cooker_m1"]
script = ExtResource("4_mod")
stat = &"burn_stacks"
value = 3.0

[sub_resource type="Resource" id="Asc_pressure_cooker"]
script = ExtResource("3_asc")
id = &"pressure_cooker"
display_name = "Pressure Cooker"
description = "Deals 70% more damage and burn stacks 3 more times."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_pressure_cooker_m0"), SubResource("Asc_pressure_cooker_m1")])

[sub_resource type="Resource" id="Asc_live_wire_m0"]
script = ExtResource("4_mod")
stat = &"chain_count"
value = 3.0

[sub_resource type="Resource" id="Asc_live_wire_m1"]
script = ExtResource("4_mod")
stat = &"attacks_per_second"
kind = 1
value = 0.3

[sub_resource type="Resource" id="Asc_live_wire"]
script = ExtResource("3_asc")
id = &"live_wire"
display_name = "Live Wire"
description = "Chains to 3 more enemies and attacks 30% faster."
modifiers = Array[ExtResource("4_mod")]([SubResource("Asc_live_wire_m0"), SubResource("Asc_live_wire_m1")])

[resource]
script = ExtResource("1_tower")
id = &"triple_thunder_geyser"
display_name = "Thunder Geyser"
description = "Superheated steam charged with lightning: scalding chains that slow everything they touch."
elements = Array[StringName]([&"fire", &"storm", &"water"])
cost = 340
damage = 22.0
attacks_per_second = 1.1
attack_range = 185.0
chain_count = 4
chain_range = 135.0
chain_falloff = 0.1
status_effects = Array[ExtResource("2_status")]([SubResource("Effect_0"), SubResource("Effect_1")])
ascendancies = Array[ExtResource("3_asc")]([SubResource("Asc_pressure_cooker"), SubResource("Asc_live_wire")])
