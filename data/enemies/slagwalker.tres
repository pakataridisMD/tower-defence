[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1_enemy"]

[resource]
script = ExtResource("1_enemy")
id = &"slagwalker"
display_name = "Slagwalker"
max_health = 120.0
speed = 50.0
armour = 12.0
bounty = 8
leak_damage = 2
tags = Array[StringName]([&"armoured"])
description = "Hollowed. A smith-lord sealed in plates of slag. Heavily armoured, but every hit knocks some of the slag away."
element = &"fire"
power = &"meltdown"
power_amount = 1.5
horde = &"flame"
lore = "The smith-lords of Pyrrhenhall turned anger into blades. When the Forge-King went mad, some turned themselves. They walk in fused plates of slag with the furnace still white inside, and every blow that lands knocks loose a plate that never grows back."
