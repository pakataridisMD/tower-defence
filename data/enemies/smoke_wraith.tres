[gd_resource type="Resource" script_class="EnemyData" format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1_enemy"]

[resource]
script = ExtResource("1_enemy")
id = &"smoke_wraith"
display_name = "Smoke Wraith"
max_health = 50.0
speed = 86.0
bounty = 5
leak_damage = 1
description = "Wild. The smoke of a burned town that would not blow away. About one blow in three goes straight through it."
element = &"fire"
power = &"smoke"
power_amount = 0.35
horde = &"flame"
lore = "When the first towns of the Ember Reach burned, their smoke did not rise. It walked. There is an ember at the heart of each one, the last warm hearth of a house no one lives in, and most of what is thrown at it passes through soot."
