[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1_enemy"]

[resource]
script = ExtResource("1_enemy")
id = &"wailing_widow"
display_name = "Wailing Widow"
max_health = 60.0
speed = 70.0
bounty = 5
leak_damage = 1
description = "Risen. A widow who followed her husband down the road of the dead. Her dying scream silences the towers near her."
element = &"void"
affinity = &"warded"
power = &"wail"
power_duration = 3.0
power_radius = 160.0
horde = &"hollow"
lore = "She would not let him walk the road alone. Nyxara's madness opened it, and she went down it after him, and found it empty. She has been screaming ever since. Struck down, the scream breaks loose, and nothing near her can work its art until it fades."
