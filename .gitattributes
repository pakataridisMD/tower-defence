# Normalise line endings for text files.
* text=auto eol=lf

# Art and audio live in Git LFS so the repository stays small.
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
assets/**/*.aseprite filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
assets/**/*.otf filter=lfs diff=lfs merge=lfs -text

# The lighting test's placeholder art is generated by tools/art/gen_lighting_demo.py and is small,
# so it is kept as plain Git files.
assets/art/lighting_demo/** -filter -diff -merge -text
# The in-game art is generated by tools/art/gen_game_art.py and is small too.
assets/art/game/** -filter -diff -merge -text
# The interface art is generated by tools/art/gen_ui_art.py and is small as well.
assets/art/ui/** -filter -diff -merge -text
# Narration is generated by tools/voice/narrate.py; LFS uploads are blocked from cloud sessions, so plain Git.
assets/story/voice/** -filter -diff -merge -text

# Story music is rendered in cloud sessions where LFS uploads are blocked.
assets/story/music/** -filter -diff -merge -text
# Gameplay music is rendered in cloud sessions too (tools/music/render_loop.py).
assets/game/music/** -filter -diff -merge -text
# Story pictures and portraits come from tools/art/story (cloud sessions cannot upload to LFS).
assets/story/images/** -filter -diff -merge -text
assets/story/portraits/** -filter -diff -merge -text
# The sound effects are rendered by tools/sfx/build.py and are small too.
assets/audio/sfx/** -filter -diff -merge -text
# The game music is rendered by tools/music/render_loop.py (on the music branch) and is small too.
