class_name TreeArt
extends RefCounted
## The pixel art for the skill trees: node frames, gems, icons and region emblems, generated by
## tools/art/gen_tree_art.py into assets/art/game/tree/. One art pixel is drawn as 2x2 screen pixels.
##
## A node's icon comes from its `icon` field if set, otherwise from what it unlocks, otherwise from the
## stat its first modifier changes. Nodes that unlock a tower show that tower's portrait instead.

const ART := "res://assets/art/game/tree/"
const SCALE := 2.0
## Size of each frame style in art pixels.
const SIZES := {
	&"start": 34, &"minor": 20, &"notable": 26, &"keystone": 30, &"bridge": 22, &"portrait": 30,
}
## Width of the frame's ring around the gem, in art pixels (the portrait's window starts inside it).
const RINGS := {
	&"start": 5, &"minor": 3, &"notable": 4, &"keystone": 4, &"bridge": 3, &"portrait": 4,
}
const ICON_SIZE := 12

## Emblems drawn beside region names: elements in the in-run web, branches in the meta tree.
const EMBLEMS := {
	&"fire": &"flame", &"storm": &"bolt", &"nature": &"leaf", &"water": &"drop", &"earth": &"rock",
	&"void": &"spiral", &"arsenal": &"swords", &"command": &"crown", &"expeditions": &"flag",
	&"mastery": &"book",
}
## Icons for stats, matched by the stat name. Whole names first, then words inside the name.
const STAT_ICONS := {
	&"damage": &"sword", &"attacks_per_second": &"speed", &"attack_range": &"range", &"cost": &"coin",
	&"bounty_bonus": &"coin", &"gold_per_wave": &"coin", &"starting_gold": &"coin", &"sell_refund": &"coin",
	&"starting_lives": &"heart", &"starting_tree_points": &"star", &"tree_points_per_boss": &"star",
	&"knockback": &"push",
}
const STAT_WORDS := {
	"burn": &"flame", "poison": &"bubbles", "chain": &"bolt", "slow": &"snowflake", "freeze": &"snowflake",
	"stun": &"hammer", "shatter": &"shatter", "curse": &"spiral", "aura": &"aura", "splash": &"burst",
	"blast": &"burst", "armor": &"shield", "armour": &"shield", "range": &"range", "gold": &"coin",
	"lives": &"heart", "points": &"star", "speed": &"speed", "damage": &"sword",
}
const FALLBACK_ICON := &"diamond"

static var _cache: Dictionary = {}


static func texture(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var path := ART + name + ".png"
	var tex: Texture2D = load(path) if ResourceLoader.exists(path) else null
	_cache[name] = tex
	return tex


static func icon(icon_name: StringName) -> Texture2D:
	var tex := texture("icon_" + icon_name)
	return tex if tex != null else texture("icon_" + FALLBACK_ICON)


## Which frame a node gets.
static func style(data: TreeNodeData) -> StringName:
	if not data.unlocks_towers.is_empty() and portrait(data.unlocks_towers[0]) != null:
		return &"portrait"
	match data.kind:
		TreeNodeData.Kind.START:
			return &"start"
		TreeNodeData.Kind.KEYSTONE:
			return &"keystone"
		TreeNodeData.Kind.BRIDGE:
			return &"bridge"
		TreeNodeData.Kind.ENTRY, TreeNodeData.Kind.NOTABLE:
			return &"notable"
	return &"minor"


## Radius on screen, used for clicks and spacing.
static func radius(data: TreeNodeData) -> float:
	return SIZES[style(data)] * SCALE * 0.5


static func node_icon(data: TreeNodeData) -> StringName:
	if not data.icon.is_empty():
		return data.icon
	if data.kind == TreeNodeData.Kind.START:
		return &"sun"
	if not data.unlocks_towers.is_empty():
		return &"tower"
	if not data.unlocks_nodes.is_empty():
		return &"key"
	if not data.unlocks_maps.is_empty():
		return &"flag"
	if not data.unlocks_difficulties.is_empty():
		return &"skull"
	for modifier in data.modifiers:
		var found := stat_icon(modifier.stat)
		if not found.is_empty():
			return found
	return EMBLEMS.get(data.region, FALLBACK_ICON)


## The icon for a stat, or empty if none fits.
static func stat_icon(stat: StringName) -> StringName:
	if STAT_ICONS.has(stat):
		return STAT_ICONS[stat]
	for word: String in STAT_WORDS:
		if String(stat).contains(word):
			return STAT_WORDS[word]
	return &""


static func emblem(region: StringName) -> Texture2D:
	return icon(EMBLEMS.get(region, FALLBACK_ICON))


## The top of a tower's picture, cut square to fit a portrait frame. Null if the tower has no art.
static func portrait(tower_id: StringName) -> Texture2D:
	var key := "portrait:" + String(tower_id)
	if _cache.has(key):
		return _cache[key]
	var picture := BoardArt.tower_picture(tower_id)
	var result: AtlasTexture = null
	if picture != null:
		var meta := BoardArt.tower_info(tower_id)
		var window: int = SIZES[&"portrait"] - 2 * RINGS[&"portrait"]
		var anchor: Array = meta.get("anchor", [picture.get_width() / 2, picture.get_height()])
		var top: int = meta.get("top", -1)
		if top < 0:
			# Start just above the first row with paint in it.
			var image := picture.get_image()
			top = 0 if image == null or image.is_empty() else maxi(0, image.get_used_rect().position.y - 1)
		result = AtlasTexture.new()
		result.atlas = picture
		result.region = Rect2(int(anchor[0]) - window / 2, top, window, window)
	_cache[key] = result
	return result
